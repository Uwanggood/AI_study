{
    "configurations": [
        {
            "name": "Python Debugger: attention/my_self_attention2.py",
            "type": "debugpy",
            "request": "launch",
            "program": "attention/my_self_attention2.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "imagenet.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Train Large Object (YOLOX)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train_large_object.py",
            "console": "integratedTerminal",
            "args": [
                "-b", "8",
                "-expn", "large_object_convnext_256",
                "-f16"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
            },
            "justMyCode": false
        },
        {
            "name": "Train Large Object (YOLOX) - Resume",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train_large_object.py",
            "console": "integratedTerminal",
            "args": [
                "-b", "8",
                "-expn", "large_object_convnext_256",
                "--resume",
                "-c", "${workspaceFolder}/YOLOX_outputs/large_object_convnext_256/latest_ckpt.pth",
                "-f16"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
            },
            "justMyCode": false
        },
        {
            "name": "Train Large Object (YOLOX) - Batch 4",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train_large_object.py",
            "console": "integratedTerminal",
            "args": [
                "-b", "4",
                "-expn", "large_object_convnext_256",
                "-f16"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
            },
            "justMyCode": false
        }
    ]
}